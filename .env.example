# ── PostgreSQL (used by docker-compose.yml) ───────────────────────
POSTGRES_USER=wayleave
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=wayleave

# ── Application Database URL ──────────────────────────────────────
# For local dev (direct PostgreSQL)
# DATABASE_URL="postgresql://wayleave:change-me-in-production@localhost:5432/wayleave?schema=public"

# For Docker (the docker-compose.yml injects this automatically)
DATABASE_URL="postgresql://wayleave:change-me-in-production@db:5432/wayleave?schema=public"
